# 해당 파일을 .env로 이름을 바꾼 다음 수정하세요.
# 주석 처리된 항목은 선택 사항입니다.

# 임베딩 모델 설정
EMBEDDING_API_KEY=
#EMBEDDING_API_URL=
#EMBEDDING_MODEL=
#EMBEDDING_DIMENSIONS=

# LLM 모델 설정 (OpenAI 및 호환 API 사용 가능)
LLM_API_KEY=
LLM_API_URL=
#LLM_MODEL=

# 임베딩 차원 설정 (임베딩 모델의 출력 차원과 일치해야 함)
#EMBEDDING_DIMENSIONS=

# Amazon OpenSearch Serverless 설정 (벡터 저장소)
# 컬렉션 엔드포인트에서 https:// 를 뺀 호스트 이름
OPENSEARCH_HOST=
#OPENSEARCH_SERVICE_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#AWS_REGION=

# MySQL 설정
MYSQL_HOST=
#MYSQL_PORT=
#MYSQL_DB=
#MYSQL_USE_SSL=
MYSQL_USER=
MYSQL_PASSWORD=

# Redis 설정
REDIS_HOST=
#REDIS_PORT=
#REDIS_USE_SSL=

# SMTP 설정
#SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# JWT 서명 설정
#JWT_SECRET=

# 프론트엔드 호스트 이름 설정
#HOSTNAME=