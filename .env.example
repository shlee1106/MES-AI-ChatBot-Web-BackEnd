# 해당 파일을 .env로 이름을 바꾼 다음 수정하세요.
# 주석 처리된 항목은 선택 사항입니다.

# 임베딩 모델 설정 (Ollama)
#EMBEDDING_MODEL=
#OLLAMA_HOST=
#OLLAMA_PORT=

# LLM 모델 설정 (OpenAI 및 호환 API 사용 가능)
LLM_API_KEY=
LLM_API_URL=
#LLM_MODEL=

# MongoDB Atlas 설정
#MONGODB_DATABASE_NAME=
MONGODB_HOST=
#MONGODB_PORT=
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MySQL 설정
MYSQL_HOST=
#MYSQL_PORT=
#MYSQL_DB=
#MYSQL_USE_SSL=
MYSQL_USER=
MYSQL_PASSWORD=

# Redis 설정
REDIS_HOST=
#REDIS_PORT=

# SMTP 설정
#SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# JWT 서명 설정
#JWT_SECRET=

# 프론트엔드 호스트 이름 설정
#HOSTNAME=