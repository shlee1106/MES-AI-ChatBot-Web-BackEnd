### 파일 업로드: 휴가지각결근정책.docx
POST http://localhost:8080/api/v1/files?shared=true
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: {{Authorization}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="휴가지각결근정책.docx"

< ../samples/휴가지각결근정책.docx
--WebAppBoundary--

### 파일 업로드: timetable.xlsx
POST http://localhost:8080/api/v1/files
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: {{Authorization}}

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="timetable.xlsx"

< ../samples/timetable.xlsx
--WebAppBoundary--

### 파일 업로드: 발표자료.pptx & 대구교통공사_월별승차.csv
POST http://localhost:8080/api/v1/files
Content-Type: multipart/form-data; boundary=WebAppBoundary
Authorization: {{Authorization}}

--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="발표자료.pptx"

< ../samples/발표자료.pptx
--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="대구교통공사_월별승차.csv"

< ../samples/대구교통공사_월별승차.csv
--WebAppBoundary--

